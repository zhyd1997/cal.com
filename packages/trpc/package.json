{
  "name": "@calcom/trpc",
  "sideEffects": false,
  "private": true,
  "description": "Shared tRPC library for Cal.com",
  "authors": "zomars",
  "version": "1.0.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js"
    },
    "./react/shared": {
      "import": "./dist/react/shared.mjs",
      "require": "./dist/react/shared.js"
    },
    "./react/trpc": {
      "import": "./dist/react/trpc.mjs",
      "require": "./dist/react/trpc.js"
    },
    "./react/hooks/useMeQuery": {
      "import": "./dist/react/hooks/useMeQuery.mjs",
      "require": "./dist/react/hooks/useMeQuery.js"
    },
    "./react/hooks/useEmailVerifyCheck": {
      "import": "./dist/react/hooks/useEmailVerifyCheck.mjs",
      "require": "./dist/react/hooks/useEmailVerifyCheck.js"
    },
    "./server": {
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js"
    },
    "./server/createNextApiHandler": {
      "import": "./dist/server/createNextApiHandler.mjs",
      "require": "./dist/server/createNextApiHandler.js"
    },
    "./server/createContext": {
      "import": "./dist/server/createContext.mjs",
      "require": "./dist/server/createContext.js"
    },
    "./server/errorFormatter": {
      "import": "./dist/server/errorFormatter.mjs",
      "require": "./dist/server/errorFormatter.js"
    },
    "./server/onErrorHandler": {
      "import": "./dist/server/onErrorHandler.mjs",
      "require": "./dist/server/onErrorHandler.js"
    },
    "./server/types": {
      "import": "./dist/server/types.mjs",
      "require": "./dist/server/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "build": "tsup",
    "dev": "tsup --watch",
    "trpc:generate": "yarn tsc --project tsconfig.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.17.15",
    "@trpc/client": "11.0.0-next-beta.222",
    "@trpc/next": "11.0.0-next-beta.222",
    "@trpc/react-query": "11.0.0-next-beta.222",
    "@trpc/server": "11.0.0-next-beta.222",
    "superjson": "1.9.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.0-beta"
  }
}
